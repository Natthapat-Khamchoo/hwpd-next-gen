# HWPD Next Gen Python Backend Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (.env ถูก gitignore ไว้แล้ว)

# บังคับต้องมี ระบบจะไม่ยอมบูตถ้าไม่ได้ตั้งค่า
# สร้างค่าใหม่: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ห้ามใช้ค่าเดิมที่เคยอยู่ในไฟล์นี้ (hwpd-sec-key-2026-*) ระบบปฏิเสธค่าเหล่านั้นแล้ว
SESSION_SECRET=

MASTER_SHEET_ID=186cb2LBLhfFD_6i-Z-kycPK_vGD4NZxkxCNI2MJop9A
LINE_TOKEN=your_line_messaging_api_channel_access_token_here

# ต้องตรงกับ pepper ฝั่ง Apps Script ไม่งั้นรหัสผ่านที่ hash ไว้แล้วใน tb_Users จะตรวจไม่ผ่าน
# PASSWORD_PEPPER=

# รายชื่อ origin ที่เรียก API ได้ คั่นด้วยจุลภาค ถ้าไม่ตั้งจะเป็น * (เปิดกว้าง)
# CORS_ORIGINS=https://your-app.vercel.app

# การเข้าถึง Google Sheets (บังคับ ถ้าไม่ตั้งค่าจะบันทึกรายงานไม่ได้เลย)
# วิธีที่ใช้อยู่: OAuth ในนามบัญชีเจ้าของโฟลเดอร์ เพราะองค์กรบล็อกการสร้าง service account key
# รับค่าสามตัวนี้ด้วย: python scripts/get_oauth_token.py
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ทางเลือกสำรอง ถ้าวันหลังใช้ service account ได้ (ใส่ path ของไฟล์ key หรือ JSON ทั้งก้อน)
# ระบบจะเลือก OAuth ก่อนเสมอถ้าตั้งค่าครบทั้งสามตัวด้านบน
# GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# โฟลเดอร์ Drive เก็บไฟล์แนบของแต่ละ กก. (เลข กก. -> folder ID)
# สคริปต์ setup_database.py สร้างให้และพิมพ์ค่านี้ออกมา ถ้า กก. ไหนไม่ได้ตั้ง
# ระบบจะรับรายงานแต่แจ้งผู้ใช้ว่าไฟล์แนบไม่ได้ถูกจัดเก็บ
DIVISION_FOLDERS_JSON={}

